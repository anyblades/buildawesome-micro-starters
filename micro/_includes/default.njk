{% extends 'blades/html.njk' %}
{% set content_for_header %}
  <meta name="generator" content="{{ site.title }}" />
  <style>
    object { vertical-align: middle } /*TODO: move to blades.css */
    body {
      padding-block: 3em;
      > footer {
        text-align: center;
        border: none;
      }
    }
  </style>
  {{ content_for_header | safe }}
{% endset %}

{% block body %}
  <main class="container breakout-all">
    Generated by <mark>{{ site.title }}</mark> from <code>{{ buildawesome.directories.input }}</code>
    <hr />
    {{ content | safe }}
  </main>
  <hr />
  <footer class="container">
    Powered by &nbsp;<a href="https://github.com/anyblades">
      <i><img src="https://img.shields.io/github/stars/anyblades?logo=_&label=🥷%20Blades" /></i>
    </a>
    © {{ site.year }}
  </footer>
{% endblock %}
