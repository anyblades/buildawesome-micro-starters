{% extends 'blades/html.njk' %}
{% set content_for_header %}
  <meta name="generator" content="{{ site.generator }}" />
  {% if og %}
    <meta property="og:image" content="{{ og | safe }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="{{ og | safe }}" />
  {% endif %}
  <style>
    body {
      padding-block: 3em;
      > footer {
        text-align: center;
        border: none;
      }
    }
  </style>
  {{ content_for_header | safe }}
{% endset %}

{% block body %}
  <main class="container breakout-all prose lg:prose-xl xl:prose-2xl">{{ content | safe }}</main>
  <footer class="container prose">
    <hr />
    {{ site.footer | safe }} © {{ site.year }}
  </footer>
{% endblock %}
